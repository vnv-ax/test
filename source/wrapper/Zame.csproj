<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Замечательно</RootNamespace>
    <AssemblyName>3</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Замечательно</AssemblyTitle>
    <Product>Замечательно</Product>
    <Company>Замечательно</Company>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- сборка Windows-приложения на Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- как в исходной сборке: самодостаточный одиночный exe со сжатием (без тримминга, как в оригинале) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- AesGcm и AES-функции требуют соответствующих_INTRINSICS; как в оригинале -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

</Project>
